class Solution {
public:
int digits(int x){
    int cnt=0;
    while(x>0){
        cnt++;
        x/=10;
    }
    return cnt;
}
    int longestCommonPrefix(vector<int>& arr1, vector<int>& arr2) {
        int ans=0;
        unordered_set<int> mp;
        for(int i=0; i<arr1.size();i++){
            int x= arr1[i];
            while(x!=0){
            mp.insert(x);
            x/=10;
        }
        }
        for(int num: arr2){
            int x=num;
            int len= digits(num);

            while(x>0){
                if(mp.count(x)) {
                    ans= max(ans,len); break;
                }
                x/=10;
                len--;
            }
        }
        return ans;
    }
};
